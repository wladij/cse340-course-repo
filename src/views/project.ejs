<%- include('partials/header') %>
<main>
    <p>
        <% if (user && user.role_name === 'admin') { %>
            <a href="/edit-project/<%= project.project_id %>" class="btn">Edit Project</a>
        <% } %>
    </p>
    <h1><%= project.title %></h1>
    <p><strong>Description:</strong> <%= project.description %></p>
    <p><strong>Date:</strong> <%= project.date %></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <p>
        <strong>Organization:</strong>
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>
    <p>
        <strong>Categories:</strong> 
        <% categories.forEach(category => { %>

            <p><a href="/category/<%= category.category_id %>">
                <%= category.category_name %>
            </a></p>

        <% }) %>
    </p>
    
    <p>
        <% if (user && user.role_name === 'admin') { %>
            <a href="/assign-categories/<%= project.project_id %>" class="btn">Edit Categories</a>
        <% } %>
    </p>
    <% if (isLoggedIn) { %>

    <% if (volunteer) { %>

        <p>You are volunteering for this project.</p>

        <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
            <button class="btn">Remove Volunteer</button>
        </form>

    <% } else { %>

        <form action="/project/<%= project.project_id %>/volunteer" method="POST">
            <button class="btn">Volunteer</button>
        </form>

    <% } %>

<% } %>
</main>
<%- include('partials/footer') %>