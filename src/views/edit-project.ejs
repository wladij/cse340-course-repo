<%- include('partials/header') %>

<main>

    <h1>Edit Project</h1>

    <% const messages = flash(); %>
    <% Object.keys(messages).forEach(type => { %>
        <% if (messages[type].length > 0) { %>
            <% messages[type].forEach(msg => { %>
                <div class="alert <%= type %>">
                    <%= msg %>
                </div>
            <% }); %>
        <% } %>
    <% }); %>

    <form action="/edit-project/<%= projectDetails.project_id %>" method="POST" class="organization-form">

        <div class="form-group">
            <label for="title">Project Title</label>
            <input
                type="text"
                id="title"
                name="title"
                value="<%= projectDetails.title %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                rows="5"
                required
            ><%= projectDetails.description %></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                value="<%= projectDetails.location %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="project_date">Project Date</label>
            <input
                type="date"
                id="project_date"
                name="project_date"
                value="<%= new Date(projectDetails.project_date).toISOString().split('T')[0] %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="organization_id">Organization</label>

            <select id="organization_id" name="organization_id" required>

                <% organizations.forEach(org => { %>

                    <option
                        value="<%= org.organization_id %>"
                        <%= org.organization_id === projectDetails.organization_id ? 'selected' : '' %>>
                        <%= org.name %>
                    </option>

                <% }) %>

            </select>

        </div>

        <button type="submit">
            Update Project
        </button>

    </form>

</main>

<%- include('partials/footer') %>