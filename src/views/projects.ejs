<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <!-- Put your page-specific content here -->
    <h2>Upcoming Service Projects</h2>
    <p><a href="/new-project" class="btn">Add a New Service Project</a></p>
    
<ul>
    <% projects.forEach(project => { %>
        
        <li>
            <%= new Date(project.date).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            }) %>:

            <strong>
                <a href="/project/<%= project.project_id %>">
                    <%= project.title %>
                </a>
            </strong>

            (
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
            )
        </li>
    <% }) %>
</ul>
</main>
<%- include('partials/footer') %>

