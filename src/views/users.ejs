<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <!-- Put your page-specific content here -->
    
<ul class="users">
    <% users.forEach(user => { %>
        <li class="user">
            <span><strong>Name</strong><br><%= user.name %></span>

            <span><strong>Email</strong><br><%= user.email %></span>

            <span><strong>Role</strong><br><%= user.role_name %></span>
        </li>
    <% }); %>
</ul>
</main>
<%- include('partials/footer') %>